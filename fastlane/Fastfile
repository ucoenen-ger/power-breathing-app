module ECKeyFix
  def new(*args)
    super
  rescue OpenSSL::PKey::ECError, OpenSSL::PKey::PKeyError
    begin
      OpenSSL::PKey.read(args[0])
    rescue OpenSSL::PKey::PKeyError, OpenSSL::PKey::ECError
      # Normalize: strip headers and all non-base64 chars, re-wrap in fresh PKCS8
      raw = args[0].to_s.gsub('\\n', "\n")
      body = raw.gsub(/-----[^-]+-----/, '').gsub(/[^A-Za-z0-9+\/=]/, '')
      pkcs8_pem = "-----BEGIN PRIVATE KEY-----\n#{body.scan(/.{1,64}/).join("\n")}\n-----END PRIVATE KEY-----\n"
      OpenSSL::PKey.read(pkcs8_pem)
    end
  end
end
OpenSSL::PKey::EC.singleton_class.prepend(ECKeyFix)

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"]

    # Normalize key content from ENV (handles literal \n from GitHub secrets)
    key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"].to_s.gsub('\\n', "\n")
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
    require 'fileutils'
    FileUtils.mkdir_p(File.dirname(key_path))
    File.write(key_path, key_content)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "ios/App/App.xcodeproj",
      team_id: "355427K34R"
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{key_path} -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}",
      output_directory: "build"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
