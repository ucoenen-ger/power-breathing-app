default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          "de.coenen.atemprotokoll" => "Atemprotokoll"
        }
      },
      output_directory: "build",
      output_name: "PowerBreathing.ipa",
      clean: true,
      silent: false
    )

    upload_to_testflight(
      username: ENV["APPLE_ID"],
      app_identifier: "de.coenen.atemprotokoll",
      ipa: "build/PowerBreathing.ipa",
      skip_waiting_for_build_processing: true,
      changelog: ENV["RELEASE_NOTES"] || "Neue Version"
    )
  end
end
