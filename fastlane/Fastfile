default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # Fix OpenSSL 3.x "invalid curve name" in spaceship token.rb
    # spaceship calls OpenSSL::PKey::EC.new which fails on OpenSSL 3.x
    require 'openssl'
    module ECKeyFix
      def new(*args, &block)
        super
      rescue OpenSSL::PKey::PKeyError
        OpenSSL::PKey.read(args.first)
      end
    end
    OpenSSL::PKey::EC.singleton_class.prepend(ECKeyFix)

    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"]

    # Normalize key content: replace literal \n, add PEM headers if missing
    key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"].gsub("\\n", "\n")
    unless key_content.include?("-----BEGIN")
      key_content = "-----BEGIN PRIVATE KEY-----\n#{key_content.strip}\n-----END PRIVATE KEY-----\n"
    end

    # Write key file
    key_dir = File.expand_path("~/.appstoreconnect/private_keys")
    sh("mkdir -p #{key_dir}")
    key_path = File.join(key_dir, "AuthKey_#{key_id}.p8")
    File.write(key_path, key_content)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "ios/App/App.xcodeproj",
      team_id: "355427K34R"
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{key_path} -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}",
      output_directory: "build",
      output_name: "PowerBreathing.ipa",
      clean: true,
      silent: false
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "de.coenen.atemprotokoll",
      ipa: "build/PowerBreathing.ipa",
      skip_waiting_for_build_processing: true,
      changelog: ENV["RELEASE_NOTES"] || "Neue Version"
    )
  end
end
