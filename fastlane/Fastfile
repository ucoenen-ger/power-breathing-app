module ECKeyFix
  def new(*args)
    super
  rescue OpenSSL::PKey::ECError, OpenSSL::PKey::PKeyError => orig_err
    str = args.first
    unless str.is_a?(String)
      raise orig_err
    end
    # Short string without PEM headers = likely a curve name (e.g. "prime256v1")
    # EC.new("curve") was removed in OpenSSL 3.x; use EC.generate instead
    if str.length <= 100 && !str.include?('-----')
      begin
        return OpenSSL::PKey::EC.generate(str)
      rescue
        raise orig_err
      end
    end

    pem = str.gsub('\\n', "\n").strip
    begin
      OpenSSL::PKey.read(pem)
    rescue OpenSSL::PKey::PKeyError, OpenSSL::PKey::ECError
      body = pem.gsub(/-----[^-]+-----/, '').gsub(/[^A-Za-z0-9+\/=]/, '')
      raise orig_err if body.length < 50
      pkcs8_pem = "-----BEGIN PRIVATE KEY-----\n#{body.scan(/.{1,64}/).join("\n")}\n-----END PRIVATE KEY-----\n"
      begin
        OpenSSL::PKey.read(pkcs8_pem)
      rescue
        raise orig_err
      end
    end
  end
end
OpenSSL::PKey::EC.singleton_class.prepend(ECKeyFix)

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"]

    key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"].to_s.gsub('\\n', "\n")
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
    require 'fileutils'
    FileUtils.mkdir_p(File.dirname(key_path))
    File.write(key_path, key_content)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "ios/App/App.xcodeproj",
      team_id: "355427K34R"
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{key_path} -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}",
      output_directory: "build"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
