default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    begin
      key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
      issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"]
      key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]

      UI.message "Key ID present: #{!key_id.nil? && !key_id.empty?}"
      UI.message "Issuer ID present: #{!issuer_id.nil? && !issuer_id.empty?}"
      UI.message "Key content length: #{key_content&.length || 0}"

      key_dir = File.expand_path("~/.appstoreconnect/private_keys")
      sh("mkdir -p #{key_dir}")
      key_path = File.join(key_dir, "AuthKey_#{key_id}.p8")
      File.write(key_path, key_content)

      api_key = app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: key_path
      )

      UI.message "Fetching provisioning profile..."
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: "de.coenen.atemprotokoll",
        readonly: false
      )

      UI.message "Updating code signing..."
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "ios/App/App.xcodeproj",
        team_id: "355427K34R",
        code_sign_identity: "iPhone Distribution",
        profile_name: ENV["SIGH_NAME"]
      )

      UI.message "Bumping build number..."
      increment_build_number(
        build_number: ENV["BUILD_NUMBER"],
        xcodeproj: "ios/App/App.xcodeproj"
      )

      increment_version_number(
        version_number: "1.2.3",
        xcodeproj: "ios/App/App.xcodeproj"
      )

      UI.message "Building..."
      build_app(
        workspace: "ios/App/App.xcworkspace",
        scheme: "App",
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build",
        output_name: "PowerBreathing.ipa",
        clean: true,
        silent: false
      )

      upload_to_testflight(
        api_key: api_key,
        app_identifier: "de.coenen.atemprotokoll",
        ipa: "build/PowerBreathing.ipa",
        skip_waiting_for_build_processing: true,
        changelog: ENV["RELEASE_NOTES"] || "Neue Version"
      )
    rescue => e
      summary_path = ENV["GITHUB_STEP_SUMMARY"]
      if summary_path
        File.open(summary_path, "a") { |f| f.puts "## Fastlane Error\n```\n#{e.message}\n#{e.backtrace[0..5].join(\"\n\")}```" }
      end
      raise e
    end
  end
end
