default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"]
    # Normalize key content (GitHub secrets may store literal \n instead of newlines)
    key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"].gsub("\\n", "\n")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false
    )

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "ios/App/App.xcodeproj",
      team_id: "355427K34R"
    )

    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{key_path} -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}",
      output_directory: "build",
      output_name: "PowerBreathing.ipa",
      clean: true,
      silent: false
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "de.coenen.atemprotokoll",
      ipa: "build/PowerBreathing.ipa",
      skip_waiting_for_build_processing: true,
      changelog: ENV["RELEASE_NOTES"] || "Neue Version"
    )
  end
end
