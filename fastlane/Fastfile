default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # Versionsnummer aus git tags ableiten (optional)
    # increment_build_number(xcodeproj: "ios/App/App.xcodeproj")

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          # Bundle ID => Name des Provisioning Profiles (wie in Xcode)
          # Wird automatisch aus dem installierten .mobileprovision gelesen
        }
      },
      output_directory: "build",
      output_name: "PowerBreathing.ipa",
      clean: true,
      silent: false
    )

    upload_to_testflight(
      apple_id: ENV["APPLE_ID"],
      app_identifier: app_identifier,
      ipa: "build/PowerBreathing.ipa",
      skip_waiting_for_build_processing: true,
      changelog: ENV["RELEASE_NOTES"] || "Neue Version"
    )
  end
end
